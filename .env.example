# ---------------------------------------------------------------------------
# Value Investing Challenge — environment
#
# The app boots with zero configuration. Everything below is optional.
# ---------------------------------------------------------------------------

# Public base URL, used for metadata / OG images / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MOCK_MODE=true  -> the platform runs entirely on the deterministic generated
#                    dataset (16 students, 10 stocks, 12 cycles). No database
#                    and no student API is contacted. This is the default.
# MOCK_MODE=false -> the platform reads from DATABASE_URL and fetches the real
#                    student endpoints declared in src/config/students.ts.
MOCK_MODE=true

# PostgreSQL connection string. Works with Neon, Supabase, or plain Postgres.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
#   Supabase: postgresql://postgres.xxx:pass@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/vic
DATABASE_URL=

# Shared secret required by the admin routes and the push-submission endpoint.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Which market data provider resolves prices when predictions mature.
# One of: mock | yahoo
MARKET_DATA_PROVIDER=mock

# Timeout (ms) applied per student endpoint during a fetch cycle.
STUDENT_FETCH_TIMEOUT_MS=8000

# Set to true on preview deployments to keep them out of search engines.
NEXT_PUBLIC_NOINDEX=false
