# ---------------------------------------------------------------------------
# LaSalle Investing — environment
#
# The app boots with zero configuration. Everything below is optional.
# ---------------------------------------------------------------------------

# Public base URL, used for metadata / OG images / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MOCK_MODE=true  -> the platform runs entirely on the deterministic generated
#                    dataset (16 students, 10 stocks, 12 cycles). No database
#                    and no student API is contacted. This is the default.
# MOCK_MODE=false -> the platform reads from DATABASE_URL and fetches the real
#                    student endpoints registered by the professor on /integrate.
MOCK_MODE=true

# PostgreSQL connection string. Works with Neon, Supabase, or plain Postgres.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
#   Supabase: postgresql://postgres.xxx:pass@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Local:    postgresql://postgres:postgres@localhost:5432/vic
#
# If DATABASE_URL is empty, the app can build it from the Supabase pieces below
# (password is URL-encoded automatically).
DATABASE_URL=

# Supabase project (optional if DATABASE_URL is set).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=eu-west-1
SUPABASE_DB_PASSWORD=
# Override only if the pooler host is not aws-0-<region>.pooler.supabase.com
# SUPABASE_POOLER_PREFIX=aws-0

# Shared secret required by the admin routes, the Sunday cron, and the
# push-submission endpoint. Generate one with: openssl rand -hex 32
# Vercel Cron also sends CRON_SECRET; if unset, ADMIN_TOKEN is used.
# vercel.json schedule: 59 21 * * 0 = Sunday 21:59 UTC = 23:59 Europe/Madrid (CEST).
ADMIN_TOKEN=
CRON_SECRET=

# Which market data provider resolves prices when predictions mature.
# One of: mock | yahoo
MARKET_DATA_PROVIDER=mock

# Timeout (ms) applied per student endpoint during a fetch cycle.
STUDENT_FETCH_TIMEOUT_MS=8000

# One feed URL that returns N influencers + their predictions.
# The Sunday job fetches this once instead of one URL per person.
INFLUENCER_FEED_URL=https://influencer-predictions.vercel.app/api/influencers
INFLUENCER_FETCH_TIMEOUT_MS=15000

# Set to true on preview deployments to keep them out of search engines.
NEXT_PUBLIC_NOINDEX=false
